	if err != nil {
		return nil, fmt.Errorf("x"+": %w", err)
	}
	result["x"] = encodedX
	encodedY, err := fgbEncode2(value.Y, depth+1, transfer)
	if err != nil {
		return nil, fmt.Errorf("y"+": %w", err)
	}
	result["y"] = encodedY
	encodedLabel, err := fgbEncode0(value.Label, depth+1, transfer)
	if err != nil {
		return nil, fmt.Errorf("label"+": %w", err)
	}
	result["label"] = encodedLabel
	return result, nil
}

func fgbDecode2(value any, path string) (int, error) {
	raw, err := fgbAsInt64(value, path)
	if err != nil {
		var zero int
		return zero, err
	}
	if int64(int(raw)) != raw {
		var zero int
		return zero, fmt.Errorf("%s: integer out of int range", path)
	}
	return int(raw), nil
}

func fgbEncode2(value int, depth int, transfer *fgbOpaqueTransfer) (any, error) {
	if depth > 64 {
		return nil, fmt.Errorf("value nesting exceeds 64 levels (cyclic reference?)")
	}
	return int64(value), nil
}

func fgbDispatch(call fgbMethodCall, transfer *fgbOpaqueTransfer) (any, *fgbCallError) {
	switch call.Method {
	case "Greeting":
		args, err := fgbRequireArgs(call.Arguments, 1)
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		arg0, err := fgbDecode0(args[0], "name")
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		result0 := api.Greeting(arg0)
		encoded, err := fgbEncode0(result0, 0, transfer)
		if err != nil {
			return nil, &fgbCallError{Code: "encode_error", Message: err.Error(), Details: map[any]any{"method": call.Method}}
		}
		return encoded, nil
	case "Point.Moved":
		args, err := fgbRequireArgs(call.Arguments, 3)
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		receiver, err := fgbDecode1(args[0], "receiver")
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		arg0, err := fgbDecode2(args[1], "dx")
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		arg1, err := fgbDecode2(args[2], "dy")
		if err != nil {
			return nil, fgbInvalidArguments(call.Method, err)
		}
		result0 := receiver.Moved(arg0, arg1)
		encoded, err := fgbEncode1(result0, 0, transfer)
		if err != nil {
			return nil, &fgbCallError{Code: "encode_error", Message: err.Error(), Details: map[any]any{"method": call.Method}}
		}
		return encoded, nil
	default:
		return nil, &fgbCallError{Code: "method_not_found", Message: fmt.Sprintf("unknown method %q", call.Method)}
	}
}

func fgbHandle(request []byte) (response []byte, transfer *fgbOpaqueTransfer) {
	transfer = &fgbOpaqueTransfer{}
	codec := fgbStandardMethodCodec{}
	defer func() {
		if recovered := recover(); recovered != nil {
			transfer.rollback()
			response = fgbEncodeCallError(codec, &fgbCallError{
				Code: "panic", Message: fmt.Sprintf("panic: %v", recovered),
				Details: map[any]any{"stack": fgbPanicStack()},
			})
		}
	}()
	call, err := codec.decodeMethodCall(request)
	if err != nil {
		return fgbEncodeCallError(codec, &fgbCallError{Code: "invalid_request", Message: err.Error()}), transfer
	}
	value, callErr := fgbDispatch(call, transfer)
	if callErr != nil {
		transfer.rollback()
		return fgbEncodeCallError(codec, callErr), transfer
	}
	response, err = codec.encodeSuccess(value)
	if err != nil {
		transfer.rollback()
		return fgbEncodeCallError(codec, &fgbCallError{Code: "encode_error", Message: err.Error()}), transfer
	}
	return response, transfer
}

func fgbPanicStack() []byte {
	if os.Getenv("FGB_DEBUG_PANIC_STACK") == "1" {
		return debug.Stack()
	}
	return nil
}

var fgbWebInvokeFunction js.Func

func fgbWebInvoke(_ js.Value, arguments []js.Value) any {
	if len(arguments) != 1 || arguments[0].Type() != js.TypeObject {
		return fgbWebBytes(fgbEncodeCallError(fgbStandardMethodCodec{}, &fgbCallError{
			Code: "invalid_request", Message: "Web bridge expects one Uint8Array argument",
		}))
	}
	request := make([]byte, arguments[0].Get("byteLength").Int())
	if copied := js.CopyBytesToGo(request, arguments[0]); copied != len(request) {
		return fgbWebBytes(fgbEncodeCallError(fgbStandardMethodCodec{}, &fgbCallError{
			Code: "invalid_request", Message: "could not copy the complete Web request",
		}))
	}
	response, transfer := fgbHandle(request)
	transfer.commit()
	return fgbWebBytes(response)
}

func fgbWebBytes(value []byte) js.Value {
	result := js.Global().Get("Uint8Array").New(len(value))
	js.CopyBytesToJS(result, value)
	return result
}

func init() {
	global := js.Global()
	registry := global.Get("__flutterGoBridge")
	if registry.Type() != js.TypeObject {
		registry = global.Get("Object").Call("create", js.Null())
		global.Set("__flutterGoBridge", registry)
	}
	fgbWebInvokeFunction = js.FuncOf(fgbWebInvoke)
	registry.Set("REPLACE_ME_GO_MOD_NAME", fgbWebInvokeFunction)
}

